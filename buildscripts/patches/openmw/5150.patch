+FORCE_INLINE void _sse2neon_set_fpcr(uint64_t value)
+{
+#if SSE2NEON_COMPILER_MSVC && !SSE2NEON_COMPILER_CLANG
+    _WriteStatusReg(ARM64_FPCR, value);
+#else
+    __asm__ __volatile__("msr FPCR, %0" ::"r"(value)); /* write */
+#endif
+}
