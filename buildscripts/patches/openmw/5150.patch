diff --git a/files/settings-default.cfg b/files/settings-default.cfg
index 2c4bbab953..20fff37ada 100644
--- a/files/settings-default.cfg
+++ b/files/settings-default.cfg
@@ -29,6 +29,47 @@ first person field of view = 60.0
 # Reverse the depth range, reduces z-fighting of distant objects and terrain
 reverse z = true
 
+# Software occlusion culling using terrain as occluder.
+# Reduces draw calls by skipping objects hidden behind terrain.
+# Only effective in exteriors with hilly terrain.
+occlusion culling = false
+
+# Use terrain heightmap as occluder. Disable to test statics-only occlusion.
+occlusion culling terrain = true
+
+# Use large static objects (buildings) as occluders. Disable to test terrain-only occlusion.
+occlusion culling statics = true
+
+# Resolution of the software occlusion depth buffer.
+occlusion buffer width = 1024
+occlusion buffer height = 512
+
+# Terrain LOD level for occlusion mesh (0=full detail, 6=very coarse).
+# Full-res heights are always fetched and min-pooled for conservative bounds.
+# LOD 2 = every 4th vertex (12800 tris at radius 2), LOD 3 = every 8th (3200 tris).
+occlusion terrain lod = 2
+
+# Radius in cells around the camera to include terrain as occluder.
+# Only needs to cover the active cell grid (CellGridRadius=1) plus margin.
+occlusion terrain radius = 2
+
+# Minimum bounding sphere radius (world units) for an object to be used as an occluder.
+# Objects with radius >= this value will be rasterized into the depth buffer as box occluders.
+# Lower values = more occluders but more rasterization cost. 200 catches most buildings.
+occlusion occluder min radius = 200
+
+# Maximum bounding sphere radius (world units) for an occluder candidate.
+# Objects larger than this are terrain chunks or object paging nodes, not buildings.
+occlusion occluder max radius = 5000
+
+# Shrink factor applied to occluder AABBs to avoid false occlusion.
+# 1.0 = full bounding box (aggressive, may over-occlude), 0.5 = half size (conservative).
+# Since AABBs from bounding spheres are already inflated, 0.5 is a reasonable default.
+occlusion occluder shrink factor = 0.5
+
+# Show the software occlusion depth buffer as an overlay in the bottom-left corner.
+occlusion debug overlay = false
+
 [Cells]
 
 # Preload cells in a background thread. All settings starting with 'preload' have no effect unless this is enabled.
-- 
