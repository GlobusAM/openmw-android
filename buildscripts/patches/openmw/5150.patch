+        vpaddl_u8(vabd_u8(vreinterpret_u8_m64(a), vreinterpret_u8_m64(b)))));
+    return vreinterpret_m64_u16(
+        vset_lane_u16(_sse2neon_static_cast(uint16_t, vget_lane_u64(t, 0)),
